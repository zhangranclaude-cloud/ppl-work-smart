@startuml
title Session fa4e0000-0000-4000-8000-000000000008\nSessionStatus: UNKNOWN | FirstFailedHop: none
hide footbox
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
actor App
participant eComm
participant Enterprise
participant EAI
App -[#orange]> eComm : [1] fundTransfer
activate eComm
eComm -[#orange]> Enterprise : [2] FundTransfer
activate Enterprise
Enterprise -[#orange]> Enterprise : [3] WS /ws/fund/transfer
activate Enterprise
Enterprise -[#orange]> EAI : [4] FT01 (FT01 ~ A01)
activate EAI
note over EAI #FFE0B2 : [4] no response in export or raw log
deactivate EAI
note over Enterprise #FFE0B2 : [3] no response in export or raw log
deactivate Enterprise
note over Enterprise #FFE0B2 : [2] no response in export or raw log
deactivate Enterprise
note over eComm #FFE0B2 : [1] no response in export or raw log
deactivate eComm
legend right
  <color:green>green</color> success · <color:red>red</color> failed · <color:orange>orange</color> unknown or no response
  <i>(Excel only)</i> = no matching raw log line · grey note = inferred
endlegend
@enduml
