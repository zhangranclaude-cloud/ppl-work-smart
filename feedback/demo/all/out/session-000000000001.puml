@startuml
title Session fa4e0000-0000-4000-8000-000000000001\nSessionStatus: SUCCESS | FirstFailedHop: none
hide footbox
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
actor App
participant eComm
App -[#green]> eComm : [1] getProfile
activate eComm
note over eComm #EEEEEE : <i>internal processing only (inferred: no downstream call logged)</i>
eComm -[#green]-> App : [2] 0000 · 18 ms
deactivate eComm
legend right
  <color:green>green</color> success · <color:red>red</color> failed · <color:orange>orange</color> unknown or no response
  <i>(Excel only)</i> = no matching raw log line · grey note = inferred
endlegend
@enduml
