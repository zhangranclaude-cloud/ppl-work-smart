case ( fundTransfer )
#palegreen:Enterprise FundTransfer\nvaries by call: see the routing table\n<i>observed · 2 sessions</i>;
note right
  observed in all calls of this API: 1 FAILED, 0 no response, of 2 calls
  codes: E1020
end note
#palegreen:eComm responds to App\n<i>observed · success 0 of 2</i>;
note right
  observed in this variant: 2 FAILED, 0 no response, of 2 calls
  codes: 9001, 1020
end note
case ( getDashboard )
#lightgrey:Enterprise AccountSummary\ninternal process\n<i>inferred: no downstream call logged · 1 session</i>;
#lightgrey:Enterprise RewardsBalance\ninternal process\n<i>inferred: no downstream call logged · 1 session</i>;
