  observed in all calls of this API: 1 FAILED, 0 no response, of 1 call
  codes: E3001
end note
#palegreen:eComm responds to App\n<i>observed · success 1 of 1</i>;
endswitch
stop
legend right
  green = observed in the export and raw log
  grey = inferred, not directly logged
  notes = observed failures
endlegend
@enduml
