``` Traceline: end-to-end trace of a request across eComm -> Enterprise -> WS -> Host ```
``` Set the session filter in step 5, or leave "*" to list every session in the time range. ```

(source="/var/log/pods/sit-01-online-*.log" ("[ECOMM-Message]" OR "[Enterprise-HostMessage]"))
OR (
    (source="/var/log/pods/microservice-sit-01-ms-*.log"
     OR source="/var/log/pods/microservice-sit-01_rewards*.log"
     OR source="/var/log/pods/microservice-sit-01_bfs*.log")
    (
        ("*WSAppLog*" ("request:" OR "RESPONSE from Enterprise" OR "Response:"))
        OR ("<EAI>" "<SvcCode>" ("Request Message" OR "Response Message"))
    )
)

``` ---------- 1. Layer ---------- ```
| eval LayerName=case(
    match(_raw, "\[ECOMM-Message\]"), "eComm",
    match(_raw, "\[Enterprise-HostMessage\]"), "Enterprise",
    match(_raw, "<SvcCode>") AND match(_raw, "(?i)(request|response) message"), "Host",
    match(_raw, "WSAppLog"), "WS")
| where isnotnull(LayerName)
| eval Layer=case(LayerName="eComm",1, LayerName="Enterprise",2, LayerName="WS",3, LayerName="Host",4)

``` ---------- 2. Direction ---------- ```
| eval Direction=case(
    LayerName="eComm"      AND match(_raw, "- Request -"),  "Request",
    LayerName="eComm"      AND match(_raw, "- Response -"), "Response",
    LayerName="Enterprise" AND match(_raw, "\[Request\]"),  "Request",
    LayerName="Enterprise" AND match(_raw, "\[Response\]"), "Response",
    LayerName="WS"   AND match(_raw, "(?i)request:"), "Request",
    LayerName="WS"   AND match(_raw, "(?i)(RESPONSE from Enterprise|Response:)"), "Response",
    LayerName="Host" AND match(_raw, "(?i)Request Message"),  "Request",
    LayerName="Host" AND match(_raw, "(?i)Response Message"), "Response")
| where isnotnull(Direction)

``` ---------- 3. Correlation keys ---------- ```
| rex field=_raw "\[ECOMM-Message\]\[\/sessionId\]\s*:\s*(?<sidEcomm>[0-9a-fA-F-]{36})"
| rex field=_raw "\[Enterprise-HostMessage\]\['sessionIdentity'\]\s*:\s*(?<sidEnterprise>[0-9a-fA-F-]{36})"
| rex field=_raw "\[\"?\s*WS:\"?\s*(?<sidWS>[0-9a-fA-F-]{36})\s*\]"
| eval sessionId=coalesce(sidEcomm, sidEnterprise, sidWS)
| rex field=_raw "(?:transactionReferenceNumber|transactionRef)\s*:\s*(?<transactionRef>[^\"]+)"
| rex field=_raw "<RqUID>(?<hostRef>[^<]+)</RqUID>"
``` ^ TODO: placeholder. Replace <RqUID> with the Host XML tag that holds an ID also logged by the WS layer. ```
| eval LinkKey=coalesce(transactionRef, hostRef)
| rex field=_raw "(?<sidAny>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})"

``` ---------- 4. Link events without a sessionId through LinkKey ---------- ```
| eventstats first(sessionId) as sidViaLink by LinkKey
| eval LinkedBy=case(isnotnull(sessionId),"sessionId", isnotnull(sidViaLink),"LinkKey", isnotnull(sidAny),"any-UUID", true(),"none")
| eval sessionId=coalesce(sessionId, sidViaLink, sidAny, "unlinked")

``` ---------- 5. Filter: put one session ID here, or leave "*" for all ---------- ```
| search sessionId="*"

``` ---------- 6. Endpoint / URL / service codes ---------- ```
| rex field=_raw "(?<Endpoint1>[^\[\]\+\s]*?(?i)Request|Response)\s*"
| rex field=_raw "(?i)endpoint?\s*:\s*(?<Endpoint2>[^ ]+)\s*(?i)(?<Endpoint3>[^\s]+)"
| eval Endpoint=coalesce(Endpoint1, Endpoint2, Endpoint3)
| rex field=_raw "(?:(?<EnterpriseEndpoint>[^\]]+)\])"
| rex field=_raw "URL\?:\s+\S+:\s*(?<URL>/\S+)"
| rex field=_raw max_match=0 "<SvcCode>(?<SvcCode>[^<]+)</SvcCode>"
| where LayerName!="Host" OR mvcount(SvcCode)>=1

``` ---------- 7. Sort: by session, then time; at equal times requests go down the layers, responses come back up ---------- ```
| eval SortKey=if(Direction="Request", Layer, -Layer)
| sort 0 sessionId _time SortKey
| eval WsURL=if(LayerName="WS", URL, null())
| streamstats last(WsURL) as LastWsURL by sessionId

``` ---------- 8. Host service pairs ---------- ```
| eval pairIndex=mvrange(0, ceil(mvcount(SvcCode)/2))
| eval HostPairs=mvmap(pairIndex,
    mvindex(SvcCode, pairIndex*2) . " ~ " .
    coalesce(mvindex(SvcCode, (pairIndex*2)+1), mvindex(SvcCode, pairIndex*2)))
| eval HostServices=if(LayerName="Host", mvjoin(HostPairs, " | "), null())

``` ---------- 9. API and elapsed time ---------- ```
``` A parent never calls the same child API twice concurrently, so each response pairs with the latest matching request. ```
| eval API=case(
    LayerName="eComm", Endpoint,
    LayerName="Enterprise", Endpoint,
    LayerName="WS", coalesce(URL, LastWsURL, EnterpriseEndpoint, "N/A"),
    LayerName="Host", EnterpriseEndpoint)
| eval PairKey=case(LayerName="Host", coalesce(EnterpriseEndpoint, ""), true(), API)
| eval ReqTime=if(Direction="Request", _time, null())
| streamstats last(ReqTime) as LastReqTime by sessionId Layer PairKey
| eval ElapsedMs=if(Direction="Response" AND isnotnull(LastReqTime),
    round((_time-LastReqTime)*1000, 0), null())

``` ---------- 10. Display ---------- ```
| eval DirectionSymbol=if(Direction="Request", "?", "!")
| eval Indent=case(Layer=1,"", Layer=2,"--› ", Layer=3,"------› ", Layer=4,"----------› ")
| eval Flow=Indent . LayerName . ": " . coalesce(API, "N/A") . " [" . DirectionSymbol . "]"
| eval Params=if(isnotnull(transactionRef) AND len(trim(transactionRef))>0,
    "TxnRefNo: " . transactionRef, null())
| streamstats count as Step by sessionId
| eval EventTime=strftime(_time, "%Y-%m-%d %H:%M:%S.%3N")
| table sessionId Step EventTime Flow HostServices Params ElapsedMs LinkKey LinkedBy
